# Copy this file to .env.local. Never put your API key in browser code or chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional tutor-specific settings. Defaults to the existing OpenAI key/model.
# OPENAI_TUTOR_API_KEY=
# OPENAI_TUTOR_MODEL=gpt-4.1-mini
# OPENAI_TUTOR_BASE_URL=https://api.openai.com/v1
# Optional current rates for this model, USD per million tokens. Leave unset to
# report token usage without inventing a price. Estimates are not billing data.
# OPENAI_TUTOR_INPUT_USD_PER_MILLION=
# OPENAI_TUTOR_OUTPUT_USD_PER_MILLION=
# Optional: absolute path for local paper storage (defaults to .papermotion).
# PAPERMOTION_DATA_DIR=C:/Papermotion/.papermotion
